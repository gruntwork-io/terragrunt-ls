{
	"name": "terragrunt-ls",
	"displayName": "Terragrunt Language Server (Official)",
	"description": "Official Terragrunt Language Server extension by Gruntwork",
	"author": "Gruntwork",
	"license": "MPL-2.0",
	"icon": "images/icon.png",
	"version": "0.0.5",
	"repository": {
		"type": "git",
		"url": "https://github.com/gruntwork-io/terragrunt-ls.git"
	},
	"publisher": "Gruntwork",
	"categories": [],
	"keywords": [
		"terragrunt opentofu terraform"
	],
	"engines": {
		"vscode": "^1.98.0"
	},
	"activationEvents": [
		"workspaceContains:**/terragrunt.hcl",
		"workspaceContains:**/terragrunt.stack.hcl",
		"workspaceContains:**/terragrunt.values.hcl"
	],
	"main": "./out/extension",
	"contributes": {
		"languages": [
			{
				"id": "terragrunt",
				"aliases": ["Terragrunt", "terragrunt"],
				"filenames": [
					"terragrunt.hcl",
					"terragrunt.stack.hcl",
					"terragrunt.values.hcl"
				],
				"configuration": "./language-configuration.json",
				"icon": {
					"light": "./images/icon-dark.svg",
					"dark": "./images/icon-light.svg"
				}
			}
		],
		"grammars": [
			{
				"language": "terragrunt",
				"scopeName": "source.hcl.terragrunt",
				"path": "./syntaxes/terragrunt.tmGrammar.json"
			}
		],
		"configuration": {
			"type": "object",
			"title": "Example configuration",
			"properties": {
				"terragrunt-ls.maxNumberOfProblems": {
					"scope": "resource",
					"type": "number",
					"default": 100,
					"description": "Controls the maximum number of problems produced by the server."
				},
				"terragrunt-ls.allow": {
					"scope": "machine",
					"type": "array",
					"items": {
						"type": "string",
						"enum": [
							"exec",
							"http",
							"sops",
							"env"
						]
					},
					"uniqueItems": true,
					"default": [],
					"markdownDescription": "Capabilities the server may use while parsing. By default it runs no commands, makes no network requests, decrypts no SOPS files, and reads no environment variables. Each value is passed to the server as `--allow`. A workspace cannot set this."
				},
				"terragrunt-ls.allowCmds": {
					"scope": "machine",
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"markdownDescription": "Programs a configuration may run while the server parses it, such as one `run_cmd()` calls, given as patterns like `jq **`. Each value is passed to the server as `--allow-cmd`. Requires `exec` in `#terragrunt-ls.allow#`. A workspace cannot set this."
				},
				"terragrunt-ls.trace.server": {
					"scope": "window",
					"type": "string",
					"enum": [
						"off",
						"messages",
						"verbose"
					],
					"default": "off",
					"description": "Traces the communication between VS Code and the language server."
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile && ./scripts/package.sh",
		"compile": "tsc -b",
		"watch": "tsc -b -w",
		"lint": "eslint"
	},
	"dependencies": {
		"glob": "14.0.3",
		"vscode-languageclient": "^11.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/mocha": "^10.0.6",
		"@types/node": "^26",
		"@types/vscode": "^1.144.0",
		"@vscode/test-electron": "^3.1.0",
		"eslint": "^10.14.0",
		"mocha": "^12.0.3",
		"nodemon": "^3.1.14",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.72.1"
	}
}
